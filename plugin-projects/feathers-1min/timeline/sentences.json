[
 {
  "i": 0,
  "start": 0.08,
  "end": 1.02,
  "text": "Monday morning."
 },
 {
  "i": 1,
  "start": 1.52,
  "end": 2.58,
  "text": "Your mom stands in the kitchen."
 },
 {
  "i": 2,
  "start": 3.36,
  "end": 3.94,
  "text": "Did you do your homework?"
 },
 {
  "i": 3,
  "start": 4.52,
  "end": 5.06,
  "text": "You did not."
 },
 {
  "i": 4,
  "start": 5.52,
  "end": 6.6,
  "text": "You played games till midnight."
 },
 {
  "i": 5,
  "start": 7.38,
  "end": 8.32,
  "text": "You say \"Yes.\""
 },
 {
  "i": 6,
  "start": 8.8,
  "end": 10.16,
  "text": "And something moves on your wrist..."
 },
 {
  "i": 7,
  "start": 10.7,
  "end": 11.02,
  "text": "A feather."
 },
 {
  "i": 8,
  "start": 11.54,
  "end": 11.92,
  "text": "Small."
 },
 {
  "i": 9,
  "start": 12.44,
  "end": 12.74,
  "text": "White."
 },
 {
  "i": 10,
  "start": 13.32,
  "end": 13.52,
  "text": "Pop."
 },
 {
  "i": 11,
  "start": 14.1,
  "end": 15.8,
  "text": "It pushes out of your skin like a sprout."
 },
 {
  "i": 12,
  "start": 16.68,
  "end": 17.82,
  "text": "You pull your sleeve down."
 },
 {
  "i": 13,
  "start": 18.16,
  "end": 18.56,
  "text": "Fast."
 },
 {
  "i": 14,
  "start": 19.2,
  "end": 19.82,
  "text": "Your name is Kai."
 },
 {
  "i": 15,
  "start": 20.34,
  "end": 21.64,
  "text": "You are sixteen."
 },
 {
  "i": 16,
  "start": 21.64,
  "end": 23.66,
  "text": "And every lie you tell grows a feather."
 },
 {
  "i": 17,
  "start": 24.32,
  "end": 26.48,
  "text": "A small lie grows a small white feather."
 },
 {
  "i": 18,
  "start": 27.02,
  "end": 29.1,
  "text": "A big lie grows a big black one."
 },
 {
  "i": 19,
  "start": 29.63,
  "end": 31.18,
  "text": "It grows in one second..."
 },
 {
  "i": 20,
  "start": 32.16,
  "end": 33.72,
  "text": "Right where everyone can see it."
 },
 {
  "i": 21,
  "start": 34.0,
  "end": 35.08,
  "text": "You cannot pull it out."
 },
 {
  "i": 22,
  "start": 35.52,
  "end": 35.98,
  "text": "It hurts..."
 },
 {
  "i": 23,
  "start": 36.5,
  "end": 37.3,
  "text": "And it grows back."
 },
 {
  "i": 24,
  "start": 37.88,
  "end": 38.08,
  "text": "Bigger."
 },
 {
  "i": 25,
  "start": 39.04,
  "end": 39.7,
  "text": "Can you stop it?"
 },
 {
  "i": 26,
  "start": 40.22,
  "end": 42.46,
  "text": "The only way to lose a feather is to tell the truth."
 },
 {
  "i": 27,
  "start": 43.04,
  "end": 43.82,
  "text": "Say it out loud..."
 },
 {
  "i": 28,
  "start": 44.36,
  "end": 45.24,
  "text": "And the feather falls."
 },
 {
  "i": 29,
  "start": 45.88,
  "end": 46.72,
  "text": "It floats away."
 },
 {
  "i": 30,
  "start": 47.56,
  "end": 49.08,
  "text": "You cannot see anyone else's."
 },
 {
  "i": 31,
  "start": 49.44,
  "end": 49.96,
  "text": "Only yours."
 },
 {
  "i": 32,
  "start": 50.56,
  "end": 51.1,
  "text": "That is the rule."
 },
 {
  "i": 33,
  "start": 51.8,
  "end": 53.86,
  "text": "So what if every lie you tell grows a feather?"
 }
]
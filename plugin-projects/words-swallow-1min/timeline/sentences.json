[
 {
  "i": 0,
  "start": 0.08,
  "end": 2.32,
  "text": "Your mom slides the toast across the table."
 },
 {
  "i": 1,
  "start": 2.84,
  "end": 3.12,
  "text": "She smiles."
 },
 {
  "i": 2,
  "start": 3.7,
  "end": 3.98,
  "text": "Eat up..."
 },
 {
  "i": 3,
  "start": 4.4,
  "end": 5.04,
  "text": "it's a good day."
 },
 {
  "i": 4,
  "start": 5.68,
  "end": 7.86,
  "text": "But above her head, grey words float."
 },
 {
  "i": 5,
  "start": 8.76,
  "end": 9.9,
  "text": "\"I'M SORRY I MISSED YOUR GAME.\""
 },
 {
  "i": 6,
  "start": 10.54,
  "end": 11.46,
  "text": "You watch them fade."
 },
 {
  "i": 7,
  "start": 12.04,
  "end": 12.9,
  "text": "She never says them."
 },
 {
  "i": 8,
  "start": 13.38,
  "end": 13.96,
  "text": "She never will."
 },
 {
  "i": 9,
  "start": 14.68,
  "end": 15.8,
  "text": "What is she sorry for?"
 },
 {
  "i": 10,
  "start": 16.62,
  "end": 18.08,
  "text": "She missed your game last Tuesday."
 },
 {
  "i": 11,
  "start": 18.6,
  "end": 19.42,
  "text": "She was working late."
 },
 {
  "i": 12,
  "start": 20.2,
  "end": 21.56,
  "text": "Six days she has carried it."
 },
 {
  "i": 13,
  "start": 21.76,
  "end": 23.0,
  "text": "And now it is gone."
 },
 {
  "i": 14,
  "start": 23.78,
  "end": 24.5,
  "text": "Your name is Eli."
 },
 {
  "i": 15,
  "start": 24.98,
  "end": 26.28,
  "text": "You are sixteen."
 },
 {
  "i": 16,
  "start": 26.28,
  "end": 28.02,
  "text": "And you can see the words people swallow."
 },
 {
  "i": 17,
  "start": 28.79,
  "end": 31.42,
  "text": "Every unsaid sentence floats above their head."
 },
 {
  "i": 18,
  "start": 31.42,
  "end": 32.8,
  "text": "Grey text."
 },
 {
  "i": 19,
  "start": 33.14,
  "end": 33.52,
  "text": "Soft."
 },
 {
  "i": 20,
  "start": 34.1,
  "end": 34.64,
  "text": "Like smoke."
 },
 {
  "i": 21,
  "start": 35.38,
  "end": 36.52,
  "text": "It hangs for a few seconds."
 },
 {
  "i": 22,
  "start": 37.22,
  "end": 37.78,
  "text": "Then it fades."
 },
 {
  "i": 23,
  "start": 38.74,
  "end": 40.92,
  "text": "Once a word fades, it is gone forever."
 },
 {
  "i": 24,
  "start": 41.78,
  "end": 43.32,
  "text": "You cannot make anyone say them."
 },
 {
  "i": 25,
  "start": 43.86,
  "end": 44.68,
  "text": "You can only watch..."
 },
 {
  "i": 26,
  "start": 45.5,
  "end": 46.74,
  "text": "You can watch a whole life..."
 },
 {
  "i": 27,
  "start": 46.74,
  "end": 48.7,
  "text": "disappear in grey letters."
 },
 {
  "i": 28,
  "start": 49.78,
  "end": 53.32,
  "text": "Once, just once, you saw a word turn gold."
 },
 {
  "i": 29,
  "start": 53.98,
  "end": 55.82,
  "text": "A girl told her friend she was sorry."
 },
 {
  "i": 30,
  "start": 56.4,
  "end": 59.26,
  "text": "The grey word turned gold and floated up, like light."
 },
 {
  "i": 31,
  "start": 60.2,
  "end": 62.06,
  "text": "So what if you could see the words people swallow?"
 }
]
[
 {
  "i": 0,
  "start": 0.08,
  "end": 2.28,
  "text": "Your mom slides the toast across the table."
 },
 {
  "i": 1,
  "start": 2.94,
  "end": 3.28,
  "text": "She smiles."
 },
 {
  "i": 2,
  "start": 4.16,
  "end": 4.4,
  "text": "Eat up..."
 },
 {
  "i": 3,
  "start": 4.86,
  "end": 5.4,
  "text": "it's a good day."
 },
 {
  "i": 4,
  "start": 6.06,
  "end": 8.38,
  "text": "But above her head, grey words float."
 },
 {
  "i": 5,
  "start": 9.2,
  "end": 10.32,
  "text": "\"I'M SORRY I MISSED YOUR GAME.\""
 },
 {
  "i": 6,
  "start": 10.98,
  "end": 11.92,
  "text": "You watch them fade."
 },
 {
  "i": 7,
  "start": 12.56,
  "end": 13.48,
  "text": "She never says them."
 },
 {
  "i": 8,
  "start": 13.92,
  "end": 14.56,
  "text": "She never will."
 },
 {
  "i": 9,
  "start": 15.3,
  "end": 16.34,
  "text": "What is she sorry for?"
 },
 {
  "i": 10,
  "start": 17.12,
  "end": 18.62,
  "text": "She missed your game last Tuesday."
 },
 {
  "i": 11,
  "start": 19.22,
  "end": 20.04,
  "text": "She was working late."
 },
 {
  "i": 12,
  "start": 20.84,
  "end": 22.26,
  "text": "Six days she has carried it."
 },
 {
  "i": 13,
  "start": 22.44,
  "end": 23.48,
  "text": "And now it is gone."
 },
 {
  "i": 14,
  "start": 24.26,
  "end": 25.02,
  "text": "Your name is Eli."
 },
 {
  "i": 15,
  "start": 25.6,
  "end": 26.96,
  "text": "You are sixteen."
 },
 {
  "i": 16,
  "start": 26.96,
  "end": 28.82,
  "text": "And you can see the words people swallow."
 },
 {
  "i": 17,
  "start": 28.82,
  "end": 32.0,
  "text": "Every unsaid sentence floats above their head."
 },
 {
  "i": 18,
  "start": 32.0,
  "end": 33.32,
  "text": "Grey text."
 },
 {
  "i": 19,
  "start": 33.9,
  "end": 34.12,
  "text": "Soft."
 },
 {
  "i": 20,
  "start": 34.78,
  "end": 35.24,
  "text": "Like smoke."
 },
 {
  "i": 21,
  "start": 36.04,
  "end": 37.16,
  "text": "It hangs for a few seconds."
 },
 {
  "i": 22,
  "start": 37.92,
  "end": 38.46,
  "text": "Then it fades."
 },
 {
  "i": 23,
  "start": 39.5,
  "end": 41.78,
  "text": "Once a word fades, it is gone forever."
 },
 {
  "i": 24,
  "start": 42.58,
  "end": 44.08,
  "text": "You cannot make anyone say them."
 },
 {
  "i": 25,
  "start": 44.62,
  "end": 45.42,
  "text": "You can only watch..."
 },
 {
  "i": 26,
  "start": 46.22,
  "end": 47.44,
  "text": "You can watch a whole life..."
 },
 {
  "i": 27,
  "start": 47.44,
  "end": 49.4,
  "text": "disappear in grey letters."
 },
 {
  "i": 28,
  "start": 50.52,
  "end": 53.7,
  "text": "Once, just once, you saw a word turn gold."
 },
 {
  "i": 29,
  "start": 54.3,
  "end": 56.1,
  "text": "A girl told her friend she was sorry."
 },
 {
  "i": 30,
  "start": 56.62,
  "end": 60.06,
  "text": "The grey word turned gold and floated up, like light."
 },
 {
  "i": 31,
  "start": 60.98,
  "end": 63.08,
  "text": "So what if you could see the words people swallow?"
 },
 {
  "i": 32,
  "start": 67.25,
  "end": 69.17,
  "text": "At school, Mr. Hale points at the board."
 },
 {
  "i": 33,
  "start": 70.11,
  "end": 71.15,
  "text": "His red pen shakes."
 },
 {
  "i": 34,
  "start": 71.85,
  "end": 74.51,
  "text": "Above his head: \"I'M AFRAID OF LOSING MY JOB.\""
 },
 {
  "i": 35,
  "start": 75.09,
  "end": 76.41,
  "text": "He says: Detention."
 },
 {
  "i": 36,
  "start": 77.57,
  "end": 78.57,
  "text": "Cole shoves a kid in the hallway."
 },
 {
  "i": 37,
  "start": 79.37,
  "end": 79.97,
  "text": "Everyone laughs."
 },
 {
  "i": 38,
  "start": 80.79,
  "end": 82.95,
  "text": "Above his head: \"MY DAD HITS ME.\""
 },
 {
  "i": 39,
  "start": 83.61,
  "end": 84.25,
  "text": "Do you tell him?"
 },
 {
  "i": 40,
  "start": 84.83,
  "end": 85.37,
  "text": "You don't."
 },
 {
  "i": 41,
  "start": 85.77,
  "end": 86.71,
  "text": "Nobody laughs at that."
 },
 {
  "i": 42,
  "start": 87.49,
  "end": 89.05,
  "text": "June sits two rows ahead."
 },
 {
  "i": 43,
  "start": 89.67,
  "end": 90.87,
  "text": "She draws birds in her notebook."
 },
 {
  "i": 44,
  "start": 91.57,
  "end": 93.25,
  "text": "Above her head: \"I LIKE YOU.\""
 },
 {
  "i": 45,
  "start": 94.07,
  "end": 95.19,
  "text": "Do you tell her you saw it?"
 },
 {
  "i": 46,
  "start": 95.69,
  "end": 96.25,
  "text": "You don't."
 },
 {
  "i": 47,
  "start": 96.65,
  "end": 97.43,
  "text": "She never looks back."
 },
 {
  "i": 48,
  "start": 98.49,
  "end": 101.17,
  "text": "Theo, your best friend since you were six, cracks a joke."
 },
 {
  "i": 49,
  "start": 102.21,
  "end": 102.87,
  "text": "Everyone laughs."
 },
 {
  "i": 50,
  "start": 103.51,
  "end": 105.47,
  "text": "Above his head: \"I MISS MY MOM.\""
 },
 {
  "i": 51,
  "start": 106.31,
  "end": 107.25,
  "text": "His mom moved away."
 },
 {
  "i": 52,
  "start": 107.83,
  "end": 108.85,
  "text": "He never talks about it."
 },
 {
  "i": 53,
  "start": 109.39,
  "end": 110.25,
  "text": "You stop laughing."
 },
 {
  "i": 54,
  "start": 110.93,
  "end": 112.89,
  "text": "On the bus, a man sits beside his wife."
 },
 {
  "i": 55,
  "start": 113.59,
  "end": 115.63,
  "text": "Above his head: \"I DON'T LOVE YOU ANYMORE.\""
 },
 {
  "i": 56,
  "start": 116.19,
  "end": 117.01,
  "text": "It fades..."
 },
 {
  "i": 57,
  "start": 117.89,
  "end": 118.67,
  "text": "he swallows it."
 },
 {
  "i": 58,
  "start": 119.23,
  "end": 119.93,
  "text": "She never knows."
 },
 {
  "i": 59,
  "start": 121.09,
  "end": 121.65,
  "text": "You feel sick."
 },
 {
  "i": 60,
  "start": 122.23,
  "end": 123.87,
  "text": "At lunch, you count the words."
 },
 {
  "i": 61,
  "start": 124.63,
  "end": 125.21,
  "text": "How many today?"
 },
 {
  "i": 62,
  "start": 125.21,
  "end": 127.09,
  "text": "Forty-three."
 },
 {
  "i": 63,
  "start": 127.09,
  "end": 127.93,
  "text": "All gone by dinner."
 },
 {
  "i": 64,
  "start": 128.71,
  "end": 129.95,
  "text": "You stop talking to people."
 },
 {
  "i": 65,
  "start": 130.51,
  "end": 130.97,
  "text": "Why bother?"
 },
 {
  "i": 66,
  "start": 131.57,
  "end": 133.03,
  "text": "You already know what they won't say."
 },
 {
  "i": 67,
  "start": 133.65,
  "end": 134.37,
  "text": "You sit alone."
 },
 {
  "i": 68,
  "start": 134.85,
  "end": 135.65,
  "text": "You carry a notebook."
 },
 {
  "i": 69,
  "start": 136.29,
  "end": 137.91,
  "text": "You write down every word you see."
 },
 {
  "i": 70,
  "start": 138.79,
  "end": 140.25,
  "text": "The apology your mom never gave."
 },
 {
  "i": 71,
  "start": 140.73,
  "end": 142.19,
  "text": "The thank you your neighbour never said."
 },
 {
  "i": 72,
  "start": 142.73,
  "end": 144.51,
  "text": "The confession your best friend never made."
 },
 {
  "i": 73,
  "start": 145.05,
  "end": 146.89,
  "text": "You tell yourself you are preserving them."
 },
 {
  "i": 74,
  "start": 146.89,
  "end": 147.83,
  "text": "You are not."
 },
 {
  "i": 75,
  "start": 147.83,
  "end": 149.67,
  "text": "You are just watching them disappear."
 },
 {
  "i": 76,
  "start": 150.57,
  "end": 151.61,
  "text": "The notebook grows thick."
 },
 {
  "i": 77,
  "start": 152.23,
  "end": 153.05,
  "text": "Your hands shake."
 },
 {
  "i": 78,
  "start": 154.17,
  "end": 156.29,
  "text": "One night, you catch yourself in the bathroom mirror."
 },
 {
  "i": 79,
  "start": 156.93,
  "end": 159.07,
  "text": "Above YOUR head, grey words float."
 },
 {
  "i": 80,
  "start": 159.99,
  "end": 160.41,
  "text": "\"I'M SORRY.\""
 },
 {
  "i": 81,
  "start": 161.15,
  "end": 161.71,
  "text": "\"I'M SCARED.\""
 },
 {
  "i": 82,
  "start": 162.41,
  "end": 163.07,
  "text": "\"I LOVE YOU.\""
 },
 {
  "i": 83,
  "start": 163.87,
  "end": 164.57,
  "text": "Dozens of them."
 },
 {
  "i": 84,
  "start": 165.03,
  "end": 165.39,
  "text": "Stacked."
 },
 {
  "i": 85,
  "start": 165.73,
  "end": 166.05,
  "text": "Fading."
 },
 {
  "i": 86,
  "start": 166.65,
  "end": 168.41,
  "text": "You have been swallowing your own words..."
 },
 {
  "i": 87,
  "start": 168.41,
  "end": 169.19,
  "text": "for years."
 },
 {
  "i": 88,
  "start": 169.69,
  "end": 171.01,
  "text": "And nobody can see them."
 },
 {
  "i": 89,
  "start": 171.67,
  "end": 172.51,
  "text": "Except you..."
 },
 {
  "i": 90,
  "start": 172.51,
  "end": 173.43,
  "text": "in the mirror."
 },
 {
  "i": 91,
  "start": 173.91,
  "end": 176.39,
  "text": "The rule was never one-sided."
 },
 {
  "i": 92,
  "start": 176.39,
  "end": 177.59,
  "text": "You were just the last to know."
 },
 {
  "i": 93,
  "start": 181.64,
  "end": 182.74,
  "text": "Your dad comes home at midnight."
 },
 {
  "i": 94,
  "start": 183.72,
  "end": 184.06,
  "text": "Warehouse nights."
 },
 {
  "i": 95,
  "start": 184.66,
  "end": 185.46,
  "text": "He opens the fridge."
 },
 {
  "i": 96,
  "start": 186.18,
  "end": 186.98,
  "text": "He looks at you."
 },
 {
  "i": 97,
  "start": 187.82,
  "end": 188.3,
  "text": "How was school?"
 },
 {
  "i": 98,
  "start": 189.36,
  "end": 189.56,
  "text": "Fine."
 },
 {
  "i": 99,
  "start": 190.24,
  "end": 193.76,
  "text": "Above his head, the same words as always: \"I'M PROUD OF YOU, SON.\""
 },
 {
  "i": 100,
  "start": 193.76,
  "end": 196.18,
  "text": "You have seen them a hundred times."
 },
 {
  "i": 101,
  "start": 196.9,
  "end": 198.0,
  "text": "He has never said them."
 },
 {
  "i": 102,
  "start": 198.52,
  "end": 199.16,
  "text": "Not once."
 },
 {
  "i": 103,
  "start": 199.78,
  "end": 200.22,
  "text": "Not ever."
 },
 {
  "i": 104,
  "start": 201.12,
  "end": 202.32,
  "text": "Can you make him say it?"
 },
 {
  "i": 105,
  "start": 203.12,
  "end": 203.52,
  "text": "No."
 },
 {
  "i": 106,
  "start": 204.24,
  "end": 204.96,
  "text": "That's the rule."
 },
 {
  "i": 107,
  "start": 205.44,
  "end": 206.94,
  "text": "So you swallow yours too."
 },
 {
  "i": 108,
  "start": 207.96,
  "end": 209.58,
  "text": "\"DAD, I FORGIVE YOU.\""
 },
 {
  "i": 109,
  "start": 210.26,
  "end": 211.78,
  "text": "It floats above your head in the mirror."
 },
 {
  "i": 110,
  "start": 211.78,
  "end": 212.9,
  "text": "And fades."
 },
 {
  "i": 111,
  "start": 213.86,
  "end": 215.6,
  "text": "Then Grandma Rose goes to the hospital."
 },
 {
  "i": 112,
  "start": 215.6,
  "end": 217.56,
  "text": "Eighty-two."
 },
 {
  "i": 113,
  "start": 217.56,
  "end": 218.94,
  "text": "The kindest person you know."
 },
 {
  "i": 114,
  "start": 219.7,
  "end": 220.44,
  "text": "You visit her."
 },
 {
  "i": 115,
  "start": 221.22,
  "end": 221.52,
  "text": "Tubes."
 },
 {
  "i": 116,
  "start": 222.0,
  "end": 222.34,
  "text": "Machines."
 },
 {
  "i": 117,
  "start": 223.2,
  "end": 224.14,
  "text": "Her eyes are closed."
 },
 {
  "i": 118,
  "start": 225.06,
  "end": 227.24,
  "text": "Above her head, grey words float."
 },
 {
  "i": 119,
  "start": 228.62,
  "end": 228.78,
  "text": "Slow..."
 },
 {
  "i": 120,
  "start": 229.42,
  "end": 229.86,
  "text": "fading."
 },
 {
  "i": 121,
  "start": 230.9,
  "end": 234.52,
  "text": "\"TELL YOUR FATHER I LOVE HIM.\""
 },
 {
  "i": 122,
  "start": 235.3,
  "end": 236.82,
  "text": "What does she want to say?"
 },
 {
  "i": 123,
  "start": 237.78,
  "end": 238.84,
  "text": "She wants Dad to know..."
 },
 {
  "i": 124,
  "start": 238.84,
  "end": 240.54,
  "text": "before it is too late."
 },
 {
  "i": 125,
  "start": 241.44,
  "end": 242.5,
  "text": "Dad is in the parking lot."
 },
 {
  "i": 126,
  "start": 243.04,
  "end": 243.82,
  "text": "He won't come up."
 },
 {
  "i": 127,
  "start": 244.3,
  "end": 245.34,
  "text": "He never comes up."
 },
 {
  "i": 128,
  "start": 245.94,
  "end": 246.3,
  "text": "You run."
 },
 {
  "i": 129,
  "start": 246.3,
  "end": 247.46,
  "text": "Down the stairs."
 },
 {
  "i": 130,
  "start": 247.46,
  "end": 248.68,
  "text": "Across the lot."
 },
 {
  "i": 131,
  "start": 249.78,
  "end": 249.98,
  "text": "Dad!"
 },
 {
  "i": 132,
  "start": 250.38,
  "end": 251.22,
  "text": "You grab his arm."
 },
 {
  "i": 133,
  "start": 251.84,
  "end": 253.22,
  "text": "Grandma wants to say she loves you."
 },
 {
  "i": 134,
  "start": 253.78,
  "end": 254.26,
  "text": "He stares."
 },
 {
  "i": 135,
  "start": 254.96,
  "end": 255.88,
  "text": "She can say it herself."
 },
 {
  "i": 136,
  "start": 256.64,
  "end": 257.18,
  "text": "No, Dad."
 },
 {
  "i": 137,
  "start": 257.4,
  "end": 258.14,
  "text": "She can't."
 },
 {
  "i": 138,
  "start": 258.34,
  "end": 258.94,
  "text": "She is trying."
 },
 {
  "i": 139,
  "start": 258.94,
  "end": 260.36,
  "text": "And her words are fading."
 },
 {
  "i": 140,
  "start": 261.14,
  "end": 261.68,
  "text": "Right now."
 },
 {
  "i": 141,
  "start": 262.12,
  "end": 263.86,
  "text": "What if it fades before he gets there?"
 },
 {
  "i": 142,
  "start": 264.48,
  "end": 265.62,
  "text": "He looks at the hospital."
 },
 {
  "i": 143,
  "start": 266.62,
  "end": 267.24,
  "text": "He looks at you."
 },
 {
  "i": 144,
  "start": 267.9,
  "end": 268.96,
  "text": "Then he runs."
 },
 {
  "i": 145,
  "start": 270.0,
  "end": 270.76,
  "text": "You follow him up."
 },
 {
  "i": 146,
  "start": 271.4,
  "end": 272.0,
  "text": "Room 312."
 },
 {
  "i": 147,
  "start": 272.98,
  "end": 273.92,
  "text": "Grandma's eyes open."
 },
 {
  "i": 148,
  "start": 274.58,
  "end": 275.48,
  "text": "Dad takes her hand."
 },
 {
  "i": 149,
  "start": 276.04,
  "end": 276.88,
  "text": "His voice breaks."
 },
 {
  "i": 150,
  "start": 277.52,
  "end": 278.04,
  "text": "Mom."
 },
 {
  "i": 151,
  "start": 278.78,
  "end": 279.62,
  "text": "I love you."
 },
 {
  "i": 152,
  "start": 280.38,
  "end": 282.32,
  "text": "And above her head, the grey words..."
 },
 {
  "i": 153,
  "start": 282.32,
  "end": 283.42,
  "text": "turn gold."
 },
 {
  "i": 154,
  "start": 284.32,
  "end": 284.94,
  "text": "They rise."
 },
 {
  "i": 155,
  "start": 284.94,
  "end": 285.96,
  "text": "Like light."
 },
 {
  "i": 156,
  "start": 286.82,
  "end": 287.38,
  "text": "Grandma smiles..."
 },
 {
  "i": 157,
  "start": 288.18,
  "end": 288.58,
  "text": "I know."
 },
 {
  "i": 158,
  "start": 292.5,
  "end": 294.24,
  "text": "That night, Dad sits on your bed."
 },
 {
  "i": 159,
  "start": 294.9,
  "end": 295.86,
  "text": "He looks at his hands..."
 },
 {
  "i": 160,
  "start": 296.58,
  "end": 296.86,
  "text": "Eli."
 },
 {
  "i": 161,
  "start": 297.2,
  "end": 298.02,
  "text": "I'm proud of you, son."
 },
 {
  "i": 162,
  "start": 298.8,
  "end": 300.28,
  "text": "The words he has swallowed for years..."
 },
 {
  "i": 163,
  "start": 300.28,
  "end": 301.48,
  "text": "finally said."
 },
 {
  "i": 164,
  "start": 302.12,
  "end": 302.6,
  "text": "Out loud."
 },
 {
  "i": 165,
  "start": 303.36,
  "end": 305.1,
  "text": "Above his head, nothing floats."
 },
 {
  "i": 166,
  "start": 305.66,
  "end": 307.26,
  "text": "Because there is nothing left to swallow."
 },
 {
  "i": 167,
  "start": 308.08,
  "end": 309.0,
  "text": "You look in the mirror."
 },
 {
  "i": 168,
  "start": 309.72,
  "end": 312.36,
  "text": "Above your head: \"DAD, I FORGIVE YOU.\""
 },
 {
  "i": 169,
  "start": 312.92,
  "end": 313.7,
  "text": "Would you say it?"
 },
 {
  "i": 170,
  "start": 314.34,
  "end": 315.04,
  "text": "You do."
 },
 {
  "i": 171,
  "start": 315.84,
  "end": 316.6,
  "text": "You turn around..."
 },
 {
  "i": 172,
  "start": 317.34,
  "end": 317.62,
  "text": "Dad."
 },
 {
  "i": 173,
  "start": 318.02,
  "end": 318.72,
  "text": "I forgive you."
 },
 {
  "i": 174,
  "start": 319.34,
  "end": 320.6,
  "text": "The words turn gold."
 },
 {
  "i": 175,
  "start": 321.12,
  "end": 321.7,
  "text": "They rise."
 },
 {
  "i": 176,
  "start": 322.56,
  "end": 323.9,
  "text": "The next day, you tell June."
 },
 {
  "i": 177,
  "start": 324.42,
  "end": 325.16,
  "text": "I like you."
 },
 {
  "i": 178,
  "start": 325.7,
  "end": 326.3,
  "text": "She blushes."
 },
 {
  "i": 179,
  "start": 327.2,
  "end": 327.56,
  "text": "I know."
 },
 {
  "i": 180,
  "start": 328.44,
  "end": 329.34,
  "text": "I swallowed it too."
 },
 {
  "i": 181,
  "start": 330.04,
  "end": 330.68,
  "text": "You tell Theo."
 },
 {
  "i": 182,
  "start": 331.26,
  "end": 332.28,
  "text": "I miss your mom too."
 },
 {
  "i": 183,
  "start": 332.92,
  "end": 333.52,
  "text": "He cries..."
 },
 {
  "i": 184,
  "start": 334.26,
  "end": 334.66,
  "text": "he laughs."
 },
 {
  "i": 185,
  "start": 335.44,
  "end": 336.58,
  "text": "You start saying everything."
 },
 {
  "i": 186,
  "start": 337.02,
  "end": 337.62,
  "text": "Every word."
 },
 {
  "i": 187,
  "start": 337.62,
  "end": 338.48,
  "text": "Before it fades."
 },
 {
  "i": 188,
  "start": 339.2,
  "end": 340.18,
  "text": "Is any of this real?"
 },
 {
  "i": 189,
  "start": 341.0,
  "end": 342.04,
  "text": "The words are fiction."
 },
 {
  "i": 190,
  "start": 342.7,
  "end": 343.68,
  "text": "The swallowing is not."
 },
 {
  "i": 191,
  "start": 344.7,
  "end": 346.88,
  "text": "Daniel Wegner at Harvard studied thought suppression."
 },
 {
  "i": 192,
  "start": 347.82,
  "end": 351.14,
  "text": "He found that trying not to think about something makes it come back stronger."
 },
 {
  "i": 193,
  "start": 351.86,
  "end": 353.32,
  "text": "What you swallow does not vanish."
 },
 {
  "i": 194,
  "start": 353.73,
  "end": 354.38,
  "text": "It waits."
 },
 {
  "i": 195,
  "start": 355.36,
  "end": 361.54,
  "text": "Psychologists Thomas Gilovich and Victoria Medvec found that in the long run, people regret the things they did NOT do..."
 },
 {
  "i": 196,
  "start": 362.44,
  "end": 363.78,
  "text": "far more than the things they did."
 },
 {
  "i": 197,
  "start": 364.28,
  "end": 365.58,
  "text": "The words they did not say."
 },
 {
  "i": 198,
  "start": 366.06,
  "end": 367.36,
  "text": "The chances they did not take."
 },
 {
  "i": 199,
  "start": 368.3,
  "end": 370.54,
  "text": "Nurse Bronnie Ware spent years with dying people."
 },
 {
  "i": 200,
  "start": 371.18,
  "end": 372.78,
  "text": "She wrote down their top five regrets."
 },
 {
  "i": 201,
  "start": 373.7,
  "end": 376.78,
  "text": "Number one: I wish I'd lived a life true to myself."
 },
 {
  "i": 202,
  "start": 377.96,
  "end": 380.64,
  "text": "Number two: I wish I hadn't worked so hard."
 },
 {
  "i": 203,
  "start": 381.24,
  "end": 384.8,
  "text": "Number three: I wish I'd had the courage to express my feelings."
 },
 {
  "i": 204,
  "start": 385.66,
  "end": 388.38,
  "text": "Number four: I wish I'd stayed in touch with friends."
 },
 {
  "i": 205,
  "start": 389.2,
  "end": 391.92,
  "text": "Number five: I wish I'd let myself be happier."
 },
 {
  "i": 206,
  "start": 392.98,
  "end": 394.84,
  "text": "The dying do not regret what they said."
 },
 {
  "i": 207,
  "start": 395.36,
  "end": 396.6,
  "text": "They regret what they swallowed."
 },
 {
  "i": 208,
  "start": 397.36,
  "end": 399.8,
  "text": "The average person has six thousand thoughts a day."
 },
 {
  "i": 209,
  "start": 400.48,
  "end": 401.98,
  "text": "How many of them do you say out loud?"
 },
 {
  "i": 210,
  "start": 402.62,
  "end": 403.46,
  "text": "How many fade..."
 },
 {
  "i": 211,
  "start": 403.46,
  "end": 404.94,
  "text": "before anyone hears them?"
 },
 {
  "i": 212,
  "start": 405.72,
  "end": 406.46,
  "text": "Next morning."
 },
 {
  "i": 213,
  "start": 406.88,
  "end": 407.22,
  "text": "The bus."
 },
 {
  "i": 214,
  "start": 407.96,
  "end": 409.7,
  "text": "A stranger sits across from you."
 },
 {
  "i": 215,
  "start": 409.7,
  "end": 412.3,
  "text": "Above her head, one grey word floats."
 },
 {
  "i": 216,
  "start": 413.18,
  "end": 413.48,
  "text": "\"GOODBYE.\""
 },
 {
  "i": 217,
  "start": 414.52,
  "end": 415.06,
  "text": "It is fading..."
 },
 {
  "i": 218,
  "start": 415.06,
  "end": 415.88,
  "text": "fast."
 },
 {
  "i": 219,
  "start": 416.64,
  "end": 417.28,
  "text": "You stand up..."
 },
 {
  "i": 220,
  "start": 417.84,
  "end": 418.44,
  "text": "What do you do?"
 },
 {
  "i": 221,
  "start": 419.02,
  "end": 420.2,
  "text": "What words have you swallowed?"
 },
 {
  "i": 222,
  "start": 420.98,
  "end": 421.74,
  "text": "What would you say..."
 },
 {
  "i": 223,
  "start": 421.74,
  "end": 423.36,
  "text": "if you had one more second?"
 },
 {
  "i": 224,
  "start": 424.22,
  "end": 424.94,
  "text": "Tell us in the comments."
 },
 {
  "i": 225,
  "start": 426.1,
  "end": 427.04,
  "text": "And if this one hit you..."
 },
 {
  "i": 226,
  "start": 427.42,
  "end": 429.8,
  "text": "hit like, and subscribe for more What Ifs."
 }
]
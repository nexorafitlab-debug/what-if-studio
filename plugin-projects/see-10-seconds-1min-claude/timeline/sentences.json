[
 {
  "i": 0,
  "start": 0.0,
  "end": 0.009,
  "text": "WHAT IF YOU COULD SEE 10 SECONDS AHEAD?"
 },
 {
  "i": 1,
  "start": 0.009,
  "end": 0.019,
  "text": "— 1-MINUTE SAMPLE SCRIPT Written by Claude Code, 2026-11-22."
 },
 {
  "i": 2,
  "start": 0.019,
  "end": 0.022,
  "text": "Hero: Kian, 17."
 },
 {
  "i": 3,
  "start": 0.022,
  "end": 0.037,
  "text": "Rule: he sees exactly 10 seconds ahead, only his own future, never off."
 },
 {
  "i": 4,
  "start": 0.037,
  "end": 0.041,
  "text": "Spoken words: ~130 (incl."
 },
 {
  "i": 5,
  "start": 0.041,
  "end": 0.043,
  "text": "countdown numbers)."
 },
 {
  "i": 6,
  "start": 0.043,
  "end": 0.047,
  "text": "Target: ~1 minute."
 },
 {
  "i": 7,
  "start": 0.047,
  "end": 0.62,
  "text": "[BEDROOM - DAWN] You wake up."
 },
 {
  "i": 8,
  "start": 0.94,
  "end": 1.9,
  "text": "The ceiling fan spins."
 },
 {
  "i": 9,
  "start": 2.76,
  "end": 4.6,
  "text": "Three seconds later — it wobbles."
 },
 {
  "i": 10,
  "start": 4.6,
  "end": 4.867,
  "text": "[10..."
 },
 {
  "i": 11,
  "start": 4.867,
  "end": 5.133,
  "text": "9..."
 },
 {
  "i": 12,
  "start": 5.133,
  "end": 7.36,
  "text": "8...] You catch the falling blade before it hits your pillow."
 },
 {
  "i": 13,
  "start": 7.36,
  "end": 8.5,
  "text": "[SCHOOL HALLWAY] Kian."
 },
 {
  "i": 14,
  "start": 9.04,
  "end": 9.64,
  "text": "That's your name."
 },
 {
  "i": 15,
  "start": 9.64,
  "end": 11.54,
  "text": "Seventeen."
 },
 {
  "i": 16,
  "start": 11.54,
  "end": 13.62,
  "text": "You see everything ten seconds before it happens."
 },
 {
  "i": 17,
  "start": 14.22,
  "end": 15.74,
  "text": "Exactly ten."
 },
 {
  "i": 18,
  "start": 15.74,
  "end": 16.72,
  "text": "Only your own future."
 },
 {
  "i": 19,
  "start": 17.36,
  "end": 17.9,
  "text": "Never off."
 },
 {
  "i": 20,
  "start": 17.9,
  "end": 19.06,
  "text": "[CAFETERIA] Lunch tray slips."
 },
 {
  "i": 21,
  "start": 19.06,
  "end": 19.22,
  "text": "[5..."
 },
 {
  "i": 22,
  "start": 19.22,
  "end": 19.38,
  "text": "4..."
 },
 {
  "i": 23,
  "start": 19.38,
  "end": 21.22,
  "text": "3...] Your hand snags it mid-air."
 },
 {
  "i": 24,
  "start": 21.22,
  "end": 21.68,
  "text": "No spill."
 },
 {
  "i": 25,
  "start": 22.1,
  "end": 22.56,
  "text": "No stares."
 },
 {
  "i": 26,
  "start": 22.56,
  "end": 23.8,
  "text": "[EXAM HALL] Pencil snaps."
 },
 {
  "i": 27,
  "start": 23.8,
  "end": 24.15,
  "text": "[2..."
 },
 {
  "i": 28,
  "start": 24.15,
  "end": 25.76,
  "text": "1...] Spare appears in your grip."
 },
 {
  "i": 29,
  "start": 26.3,
  "end": 27.2,
  "text": "Teacher never notices."
 },
 {
  "i": 30,
  "start": 27.2,
  "end": 28.86,
  "text": "[BUSY STREET] Bus brakes."
 },
 {
  "i": 31,
  "start": 28.86,
  "end": 29.44,
  "text": "Doors hiss."
 },
 {
  "i": 32,
  "start": 30.12,
  "end": 31.14,
  "text": "You're already stepping on."
 },
 {
  "i": 33,
  "start": 31.8,
  "end": 34.42,
  "text": "The crowd surges behind you — three seconds late."
 },
 {
  "i": 34,
  "start": 34.42,
  "end": 35.74,
  "text": "[ROOFTOP - SUNSET] Wind gusts."
 },
 {
  "i": 35,
  "start": 35.92,
  "end": 36.54,
  "text": "Your phone slips."
 },
 {
  "i": 36,
  "start": 36.54,
  "end": 36.767,
  "text": "[10..."
 },
 {
  "i": 37,
  "start": 36.767,
  "end": 36.993,
  "text": "9..."
 },
 {
  "i": 38,
  "start": 36.993,
  "end": 37.94,
  "text": "8...] You watch it fall."
 },
 {
  "i": 39,
  "start": 41.94,
  "end": 42.56,
  "text": "You *could* catch it."
 },
 {
  "i": 40,
  "start": 43.02,
  "end": 45.66,
  "text": "But the vision shows the girl behind you — she reaches."
 },
 {
  "i": 41,
  "start": 46.24,
  "end": 47.02,
  "text": "She catches it."
 },
 {
  "i": 42,
  "start": 47.54,
  "end": 48.08,
  "text": "She smiles."
 },
 {
  "i": 43,
  "start": 48.08,
  "end": 50.36,
  "text": "[BLACK SCREEN] What happens when you stop preventing..."
 },
 {
  "i": 44,
  "start": 50.36,
  "end": 51.84,
  "text": "and start choosing?"
 }
]